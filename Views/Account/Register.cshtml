@model AutoSecurity.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registar";
}

<div class="mt-loginContainer">
    <div class="mt-loginBox">

        <form asp-controller="Account" asp-action="Register" method="post" class="mt-loginForm">
            @Html.AntiForgeryToken()

            <div style="text-align:center; margin-bottom: 4px;">
                <h1 style="margin:0 0 6px; font-size:24px; letter-spacing:-0.03em;">Criar conta</h1>
                <p style="margin:0; color: var(--mt-muted); font-size:13px;">Regista-te com o teu Gmail</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mt-loginError">
                    @Html.ValidationSummary(false, "")
                </div>
            }

            <!-- Nome -->
            <div class="mt-lineField">
                <span class="mt-fieldIcon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </span>
                <input asp-for="Name" placeholder="Nome completo" autocomplete="name" />
            </div>
            <span asp-validation-for="Name" class="mt-fieldValError"></span>

            <!-- Email / Gmail -->
            <div class="mt-lineField">
                <span class="mt-fieldIcon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </span>
                <input asp-for="Email" placeholder="O teu Gmail (ex: nome@gmail.com)" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="mt-fieldValError"></span>

            <!-- Senha -->
            <div class="mt-lineField">
                <span class="mt-fieldIcon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </span>
                <input asp-for="Password" id="regPass" type="password" placeholder="Senha" />
                <button type="button" class="mt-eyeIcon" data-target="regPass" aria-label="Mostrar senha">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="mt-fieldValError"></span>

            <!-- Confirmar senha -->
            <div class="mt-lineField">
                <span class="mt-fieldIcon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </span>
                <input asp-for="ConfirmPassword" id="regPass2" type="password" placeholder="Confirmar senha" />
                <button type="button" class="mt-eyeIcon" data-target="regPass2" aria-label="Mostrar senha">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="mt-fieldValError"></span>

            <button type="submit" class="mt-btnLoginBtn" style="width:100%; margin-top:8px;">
                CRIAR CONTA
            </button>

            <!-- Botão visual "Gmail" (UI). OAuth real pede setup no Google Cloud. -->
            <div class="mt-orDivider"><span>ou</span></div>

            <a class="mt-googleBtn" href="#" title="Em breve: login real com Google">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.5-.4-3.5z"/>
                    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.1 4 9.2 8.5 6.3 14.7z"/>
                    <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.3 36 26.8 37 24 37c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.1 39.5 16 44 24 44z"/>
                    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.2-3.6 5.7-6.6 7.1l.1.1 6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.5-.4-3.5z"/>
                </svg>
                Continuar com Gmail
            </a>
        </form>

        <div class="mt-loginFooter">
            <p>Já tem conta?</p>
            <a class="mt-registerBtn" asp-controller="Account" asp-action="Login">ENTRAR</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.mt-eyeIcon[data-target]').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = document.getElementById(btn.getAttribute('data-target'));
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
            });
        });
    </script>
}